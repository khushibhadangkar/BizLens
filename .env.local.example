# ============================================================
# BizLens Frontend — Environment Configuration
# ============================================================
# Copy this file to .env.local and fill in actual values.
# NEVER commit .env.local to version control.
# ============================================================

# The URL of the FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Supabase Configuration
# Required for authentication and generating the JWT for the backend.
# These values are safe to expose to the browser (public keys).
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
