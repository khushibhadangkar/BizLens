# ============================================================
# BizLens Backend — Environment Configuration
# ============================================================
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# --- Database (Supabase PostgreSQL) ---
# Connection string for your Supabase PostgreSQL instance.
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://user:password@localhost:5432/bizlens

# --- Supabase ---
# Found in: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# JWT secret used to verify Supabase-issued JWTs.
# Found in: Supabase Dashboard → Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000
